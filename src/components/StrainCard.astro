---
import type { CollectionEntry } from 'astro:content';
import StrainCover from './StrainCover.astro';

interface Props {
  strain: CollectionEntry<'strains'>;
}

const { strain } = Astro.props;
const { name, type, cannabinoids, effects, cultivation, dominance, color, image } = strain.data;

const typeLabel: Record<string, string> = {
  indica: 'Indica',
  sativa: 'Sativa',
  hibrida: 'Híbrida',
};
const typeChipClass: Record<string, string> = {
  indica: 'chip-haze',
  sativa: 'chip-amber',
  hibrida: 'chip-leaf',
};
---

<a href={`/strains/${strain.id}`} class="card block group overflow-hidden">
  <div class="relative">
    <StrainCover name={name} type={type} color={color} image={image} />
    <span class={`chip ${typeChipClass[type]} absolute top-3 right-3 backdrop-blur-sm`}>
      {typeLabel[type]}
    </span>
  </div>

  <div class="p-6">
    <h3 class="font-[var(--font-display)] text-xl font-semibold text-white group-hover:text-leaf-300 transition-colors">
      {name}
    </h3>

    {dominance && <p class="text-xs text-ink-400 mt-1 mb-3">{dominance}</p>}

    <dl class="grid grid-cols-2 gap-3 text-sm mt-3">
      <div>
        <dt class="text-ink-400 text-xs">THC</dt>
        <dd class="text-white font-medium">{cannabinoids.thc ?? '—'}</dd>
      </div>
      <div>
        <dt class="text-ink-400 text-xs">CBD</dt>
        <dd class="text-white font-medium">{cannabinoids.cbd ?? '—'}</dd>
      </div>
      <div>
        <dt class="text-ink-400 text-xs">Floração</dt>
        <dd class="text-white font-medium">{cultivation.flowering ?? '—'}</dd>
      </div>
      <div>
        <dt class="text-ink-400 text-xs">Dificuldade</dt>
        <dd class="text-white font-medium capitalize">{cultivation.difficulty}</dd>
      </div>
    </dl>

    {effects.length > 0 && (
      <div class="mt-4 flex flex-wrap gap-1.5">
        {effects.slice(0, 4).map((e) => <span class="chip">{e}</span>)}
      </div>
    )}
  </div>
</a>
