---
const pathname = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? pathname === '/' : pathname.startsWith(href);

const links = [
  { href: '/', label: 'Início' },
  { href: '/blog', label: 'Blog' },
  { href: '/strains', label: 'Strains' },
  { href: '/sobre', label: 'Sobre' },
];
---

<header class="sticky top-0 z-40 backdrop-blur-md bg-[rgba(10,36,19,0.55)] border-b border-white/5">
  <div class="container-page flex items-center justify-between h-16">
    <a href="/" class="flex items-center gap-2 font-[var(--font-display)] font-semibold text-lg">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="h-7 w-7 text-leaf-400" fill="currentColor" aria-hidden="true">
        <path d="M12 2c.7 2.6 2 5 4 6.8-2 .3-3.8 1.3-5 2.9-1.2-1.6-3-2.6-5-2.9 2-1.8 3.3-4.2 4-6.8zm-8 8.5c2.2.3 4.2 1.6 5.3 3.5-2.1.5-4 1.7-5.3 3.5-.3-2.4-.3-4.7 0-7zm16 0c.3 2.3.3 4.6 0 7-1.3-1.8-3.2-3-5.3-3.5 1.1-1.9 3.1-3.2 5.3-3.5zM12 13c1.7 1.8 2.6 4.1 2.7 6.5-.9-.5-1.8-.8-2.7-.9-.9.1-1.8.4-2.7.9.1-2.4 1-4.7 2.7-6.5zm0 9c-.3-.7-.6-1.3-1-1.8.3-.1.7-.2 1-.2s.7.1 1 .2c-.4.5-.7 1.1-1 1.8z"/>
      </svg>
      <span>Ervário</span>
    </a>

    <nav class="hidden md:flex items-center gap-1">
      {links.map((l) => (
        <a
          href={l.href}
          class:list={[
            'px-3 py-1.5 rounded-lg text-sm transition-colors',
            isActive(l.href)
              ? 'bg-white/10 text-white'
              : 'text-ink-200 hover:text-white hover:bg-white/5',
          ]}
        >
          {l.label}
        </a>
      ))}
    </nav>

    <details class="md:hidden relative">
      <summary class="list-none cursor-pointer p-2 rounded-lg hover:bg-white/5" aria-label="Abrir menu">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M4 6h16M4 12h16M4 18h16" stroke-linecap="round" />
        </svg>
      </summary>
      <div class="absolute right-0 mt-2 w-48 rounded-xl border border-white/10 bg-ink-900 p-2 shadow-2xl">
        {links.map((l) => (
          <a
            href={l.href}
            class:list={[
              'block px-3 py-2 rounded-lg text-sm',
              isActive(l.href) ? 'bg-white/10 text-white' : 'text-ink-200 hover:bg-white/5',
            ]}
          >
            {l.label}
          </a>
        ))}
      </div>
    </details>
  </div>
</header>
