---
interface Props {
  name: string;
  type: 'indica' | 'sativa' | 'hibrida';
  color?: string;
  image?: string;
  class?: string;
}

const { name, type, color = 'leaf', image, class: className = '' } = Astro.props;

const initial = name.trim().charAt(0).toUpperCase();

const palettes: Record<string, { from: string; to: string; accent: string; leafOpacity: number }> = {
  leaf:  { from: '#206332', to: '#0a2413', accent: '#8dd29a', leafOpacity: 0.18 },
  haze:  { from: '#531c95', to: '#1a1a1f', accent: '#c9a4ff', leafOpacity: 0.18 },
  amber: { from: '#8a5a0b', to: '#1a1a1f', accent: '#fcd34d', leafOpacity: 0.18 },
};

const typePalette: Record<string, keyof typeof palettes> = {
  sativa: 'amber',
  indica: 'haze',
  hibrida: 'leaf',
};

const pal = palettes[color] ?? palettes[typePalette[type]] ?? palettes.leaf;

const uid = `sc-${Math.random().toString(36).slice(2, 9)}`;
---

<div class:list={['strain-cover relative w-full overflow-hidden rounded-xl', className]}>
  {image ? (
    <img
      src={image}
      alt={`Foto da strain ${name}`}
      loading="lazy"
      decoding="async"
      class="h-full w-full object-cover"
    />
  ) : (
    <svg
      viewBox="0 0 400 220"
      preserveAspectRatio="xMidYMid slice"
      class="h-full w-full"
      role="img"
      aria-label={`Ilustração representando a strain ${name}`}
    >
      <defs>
        <radialGradient id={`bg-${uid}`} cx="30%" cy="20%" r="90%">
          <stop offset="0%" stop-color={pal.from} />
          <stop offset="100%" stop-color={pal.to} />
        </radialGradient>
        <linearGradient id={`fade-${uid}`} x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="rgba(0,0,0,0)" />
          <stop offset="100%" stop-color="rgba(0,0,0,0.35)" />
        </linearGradient>
      </defs>

      <rect width="400" height="220" fill={`url(#bg-${uid})`} />

      <circle cx="330" cy="40" r="70" fill={pal.accent} opacity="0.08" />
      <circle cx="60" cy="190" r="90" fill={pal.accent} opacity="0.07" />

      <g opacity={pal.leafOpacity} fill={pal.accent} transform="translate(260 10) scale(7)">
        <path d="M12 2c.7 2.6 2 5 4 6.8-2 .3-3.8 1.3-5 2.9-1.2-1.6-3-2.6-5-2.9 2-1.8 3.3-4.2 4-6.8zm-8 8.5c2.2.3 4.2 1.6 5.3 3.5-2.1.5-4 1.7-5.3 3.5-.3-2.4-.3-4.7 0-7zm16 0c.3 2.3.3 4.6 0 7-1.3-1.8-3.2-3-5.3-3.5 1.1-1.9 3.1-3.2 5.3-3.5zM12 13c1.7 1.8 2.6 4.1 2.7 6.5-.9-.5-1.8-.8-2.7-.9-.9.1-1.8.4-2.7.9.1-2.4 1-4.7 2.7-6.5z" />
      </g>

      <text
        x="36"
        y="160"
        font-family="Space Grotesk, Inter, sans-serif"
        font-weight="700"
        font-size="140"
        fill="rgba(255,255,255,0.92)"
        style="letter-spacing: -0.04em"
      >
        {initial}
      </text>

      <text
        x="36"
        y="188"
        font-family="Inter, sans-serif"
        font-weight="500"
        font-size="14"
        fill={pal.accent}
        style="letter-spacing: 0.12em; text-transform: uppercase"
      >
        {name}
      </text>

      <rect width="400" height="220" fill={`url(#fade-${uid})`} />
    </svg>
  )}
</div>

<style>
  .strain-cover { aspect-ratio: 20 / 11; }
</style>
